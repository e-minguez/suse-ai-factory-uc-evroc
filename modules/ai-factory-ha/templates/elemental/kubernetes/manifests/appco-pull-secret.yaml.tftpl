# The chart sets global.imagePullSecrets: [{name: application-collection}], so
# it expects a Secret with exactly this name in its own namespace.
apiVersion: v1
kind: Namespace
metadata:
  name: ${namespace}
---
apiVersion: v1
kind: Secret
metadata:
  name: application-collection
  namespace: ${namespace}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: ${dockerconfigjson_b64}
